# ============================================================
# Shackles Symposium - Environment Configuration
# ============================================================
# Copy this file to .env for local development:
#   Copy-Item .env.example .env       (Windows PowerShell)
#   cp .env.example .env               (macOS/Linux)
# ============================================================

# ---- Application ----
APP_NAME=Shackles Symposium
ENVIRONMENT=development
DEBUG=true
ACTIVE_YEAR=2026

# ---- Database (local Postgres via docker-compose) ----
DATABASE_URL=postgresql+asyncpg://shackles:shackles_dev@localhost:5432/shackles

# ---- Redis / Valkey (local via docker-compose) ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
SECRET_KEY=dev-only-secret-key-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Storage (local filesystem for dev) ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage

# ---- Email (Resend or SMTP / MailHog) ----
# Leave RESEND_API_KEY and SMTP_HOST empty in dev to log emails to stdout,
# or set SMTP_HOST=localhost and SMTP_PORT=1025 to inspect emails in MailHog (http://localhost:8025).
RESEND_API_KEY=
EMAIL_FROM=Shackles <noreply@shackles.local>
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ---- Public URLs ----
PUBLIC_APP_URL=http://localhost:8000